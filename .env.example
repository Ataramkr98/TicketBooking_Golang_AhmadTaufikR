# Application environment. Accepted values (case-insensitive, surrounding
# whitespace ignored): development | dev | local, staging | stage | stg,
# production | prod. An empty value means development. Anything else is a
# startup error, not a silent fallback.
#
# production AND staging run every production guard: 32-byte secrets (no
# .env.example placeholders), PII_ENCRYPTION_KEY required, CACHE_DRIVER=redis,
# Secure cookies, no /simulate-success endpoint (404), no payment webhook (501),
# and no debug_code in the OTP response. Staging is grouped with production on
# purpose: it usually holds a copy of production PII and is reachable off-site.
# Only development relaxes those, which is what enables the simulator payment
# provider and the debug_code echo.
APP_ENV=development
# Listen address for the HTTP API
HTTP_ADDR=:8080
# PostgreSQL connection string (Neon: use ?sslmode=require). Never commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elysian?sslmode=disable
# Seat locks / OTP / expiry: memory (single-instance dev) or redis (required outside development)
CACHE_DRIVER=memory
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# Comma-separated allowed browser origins for the SPA
CORS_ORIGINS=http://localhost:5173
# Session signing secret (>= 32 random bytes). In development an omitted value
# falls back to a generated development-only constant; outside development it is
# a startup error.
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Development-only sample key. Generate a unique 32-byte base64 key before production.
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
PII_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Blind-index key for deterministic phone/contact hashes (>= 32 random bytes)
PII_HASH_KEY=replace-with-at-least-32-random-bytes
# Admin JWT signing secret (>= 32 random bytes)
JWT_SECRET=replace-with-at-least-32-random-bytes
# HMAC key for boarding-pass / QR token payloads (>= 32 random bytes)
QR_SIGNING_KEY=replace-with-at-least-32-random-bytes
# VAT / tax rate applied at checkout (0..1)
TAX_RATE=0.11
# Default seat hold duration
SEAT_HOLD_TTL=10m
# OTP lifetime and attempt limit
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
# Seed admin account. ADMIN_SEED_PASSWORD must be set outside development: the
# seed refuses to run against a production or staging database with the
# published demo password. Outside development the seed also requires
# OPERATOR_SEED_PASSWORD.
ADMIN_SEED_EMAIL=admin@elysian.local
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROLE=admin
# Seed operator account (role=operator, station staff)
OPERATOR_SEED_EMAIL=operator@elysian.local
OPERATOR_SEED_PASSWORD=

# ---------------------------------------------------------------- test only --
# Integration tests are behind the `integration` build tag and skip without
# these. Point them at a throwaway database: the suite drops and recreates
# every table (001_init.up.sql) and leaves it empty on exit.
#   go test -tags=integration ./...
# Database used by internal/service/integration_test.go. Rewritten per run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/elysian_test?sslmode=disable
# Redis used when the suite is run with a real cache driver. Defaults to the
# memory store when unset.
TEST_REDIS_URL=redis://127.0.0.1:6379/15